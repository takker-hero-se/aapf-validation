# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# AAPF verification sandbox (Windows, VMware Desktop).
#
# --- WinRM note -------------------------------------------------------------
# Earlier boot timeouts were blamed on the host's "VMware NAT Service"
# (vmnat.exe) failing its NAT-DNS bind when Hyper-V/WSL2 already holds UDP 53,
# and were "fixed" by disabling Vagrant's NAT port-forwards outright. That was
# wrong, and the forwarded_port block below now carries the measured answer:
# the forwards stay ENABLED on non-default host ports. See that block.
#
# --- Where the VM's disks live ----------------------------------------------
# Vagrant puts a cloned VM's disks in .vagrant/ next to this file -- several GB.
# If you extracted this sandbox inside a synced folder (OneDrive, Dropbox), the
# sync client will try to upload them while the VM runs. Point the state
# directory somewhere local first, for EVERY invocation in the session:
#     $env:VAGRANT_DOTFILE_PATH = "C:\vagrant-state\aapf-verify"
# A hostOnly DHCP adapter is declared either way, as a direct route that does
# not depend on the NAT service.

Vagrant.configure("2") do |config|
  ENV['VAGRANT_DEFAULT_PROVIDER'] = 'vmware_desktop'

  config.vm.box          = "gusztavvargadr/windows-server-2022-standard"
  # PINNED: this sandbox's 32 assertions were measured on this image. Unpinned,
  # Vagrant takes whatever is current and the evidence stops being replayable.
  config.vm.box_version  = ENV['WS2022_BOX_VERSION'] || "2607.0.0"
  config.vm.guest        = :windows
  config.vm.communicator = "winrm"
  config.winrm.username  = "vagrant"
  config.winrm.password  = "vagrant"
  config.winrm.retry_limit = 30
  config.winrm.retry_delay = 10
  # 30 min, not 15: on a memory-constrained host this guest boots slowly, and a
  # boot that is merely slow is indistinguishable from a WinRM fault from here.
  # Two runs were lost to the 15-minute limit before this was raised; the
  # generation sandbox had already made the same change for the same reason.
  config.vm.boot_timeout   = 1800

  # --- NAT port-forwards: ENABLED, on non-default host ports -------------------
  # This is the only configuration measured to work on this host, and the
  # reasoning is not obvious, so: Vagrant derives the WinRM endpoint from the
  # forwarded_port declaration. Declaring it `disabled: true` does NOT make
  # Vagrant fall back to the guest address -- it still announces
  # 127.0.0.1:<host>, now pointing at a forward nobody created, and the boot
  # times out. Leaving the forward ENABLED but on a NON-DEFAULT host port makes
  # Vagrant use the guest's hostOnly address instead, which answers.
  #
  # Keeping Vagrant's default 55985 also fails: vmnat accepts the TCP connection
  # but never relays it, so the port tests "reachable" while a real request to
  # /wsman times out. Check with an actual HTTP request, never Test-NetConnection.
  #
  # The two sandboxes must not share host ports either: Vagrant only
  # auto-corrects collisions within one environment, so vmnat ends up forwarding
  # to whichever guest registered last.
  #     verification sandbox : 55975 / 55976 / 53385
  #     generation sandbox   : 55995 / 55996 / 53390
  # Set AAPF_NO_NAT=1 to drop the forwards entirely if vmnat is truly dead.
  nat_broken = ENV['AAPF_NO_NAT'] == '1'
  config.vm.network "forwarded_port", id: "winrm",     guest: 5985, host: 55975, disabled: nat_broken
  config.vm.network "forwarded_port", id: "winrm-ssl", guest: 5986, host: 55976, disabled: nat_broken
  config.vm.network "forwarded_port", id: "rdp",       guest: 3389, host: 53385, disabled: nat_broken
  # hostOnly adapter with DHCP: a reliable direct route that needs no NAT service
  config.vm.network "private_network", type: "dhcp"

  # --- Synced folders (VMware HGFS; independent of the NAT service) -----------
  # "../.." is the extracted Zenodo/repo root (it must contain samples/ and
  # poneglyph/poneglyph.exe). Vagrant resolves this relative to THIS Vagrantfile,
  # so no host-specific path edit is needed when run from reproduction/sandbox/.
  # AAPF_CORPUS overrides it when the corpus lives somewhere else.
  corpus = ENV['AAPF_CORPUS'] || '../..'
  config.vm.synced_folder corpus, "C:\\aapf"                      # corpus + poneglyph.exe
  config.vm.synced_folder "./output", "C:\\out", create: true    # results (video/log) back to host

  # --- Provider --------------------------------------------------------------
  config.vm.provider "vmware_desktop" do |v|
    v.force_vmware_license = "workstation"   # exGOAD: fixes a vagrant plugin issue
    v.gui = true                             # visible console for screen recording
    # AAPF_MEMSIZE lowers this on a host that cannot spare 4 GB. The default is
    # what VERIFICATION.md assumes; only the env var deviates from it.
    v.vmx["memsize"]  = ENV['AAPF_MEMSIZE'] || "4096"
    v.vmx["numvcpus"] = "2"
  end

  # --- Our sandbox provisioning ---------------------------------------------
  config.vm.provision "file",  source: "scripts", destination: "C:/scripts"
  config.vm.provision "shell", path: "scripts/provision.ps1"
  config.vm.provision "shell", reboot: true,
    inline: "Write-Host 'Rebooting into the recorded verification run...'"

  config.vm.post_up_message = <<-MSG
  ============================================================
  Sandbox up (direct-IP WinRM, NAT port-forward disabled) and
  rebooting into the recorded verification.
  Results appear on the HOST in ./output/ :
      verification-<timestamp>.mp4 / .log  and  DONE.txt
  ============================================================
  MSG
end
